# Copia este archivo a .streamlit/secrets.toml (local) y NUNCA lo subas al repo.
# En Streamlit Community Cloud, estos mismos valores se pegan en
# "Settings > Secrets" del dashboard de la app (no se sube archivo).

google_sheet_id = "PEGA_AQUI_EL_ID_DEL_GOOGLE_SHEET"
admin_password = "elige-una-clave-fuerte-para-administracion"

[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto-gcp"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "tu-cuenta-servicio@tu-proyecto-gcp.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
